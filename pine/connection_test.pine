//@version=6
indicator("BybitFlow CONNECTION TEST — NOT A TRADE", overlay=true)
// No footprint requirement. Creates one real webhook transport test on the next closed 15M bar.
// Set FLOW_RESEARCH_ALERTS=true to forward its clearly labeled test card to the research channel.
if timeframe.period != "15" or not chart.is_standard
    runtime.error("Use a standard 15-minute Bybit perpetual chart")
var bool sent = false
if barstate.isrealtime and barstate.isconfirmed and not sent
    string id = "connection-test-" + syminfo.ticker + "-" + str.tostring(time_close)
    string message = '{"event_id":"' + id + '","signal_id":"' + id + '","symbol":"' + syminfo.tickerid + '","event":"connection_test","source_ms":' + str.tostring(timenow) + ',"bar_close_ms":' + str.tostring(time_close) + ',"timeframe":"15","price":' + str.tostring(close, format.mintick) + '}'
    alert(message, alert.freq_once_per_bar_close)
    sent := true
plot(close, display=display.none)
