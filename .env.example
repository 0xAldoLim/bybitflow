# No exchange keys are needed or accepted.
FLOW_DATA_DIR=./data
FLOW_MARKET_SOURCE=auto
FLOW_SCAN_ENABLED=true
FLOW_SSS_RESEARCH=false
FLOW_ML_ENABLED=false
FLOW_ML_TWO_STAGE=false
FLOW_ML_FILTER_RESEARCH=false
FLOW_VALIDATED_ALERT_TIERS=["SSS"]
# Separate operational notices; optional. No automatic model promotion.
FLOW_OPS_WEBHOOK=
FLOW_SCAN_SECONDS=300
# Recording budget in decimal GB; size for available disk and subscription volume.
FLOW_MAX_STORAGE_GB=10
# After ML outcome processing, prune eligible raw segments at 85% down toward 60%.
# Keeps at least six hours; snapshots, labels, models and audit hashes are retained.
FLOW_RECORDING_RETENTION_ENABLED=false
# Independent causal policies; extended swing remains shadow research.
FLOW_HORIZON_PROFILES=["CORE_INTRADAY","SHORT_INTRADAY","SWING","EXTENDED_SWING"]
FLOW_EXPLORATION_FRACTION=0.125
FLOW_POST_TERMINAL_ENABLED=true
# Optional increasing checkpoint minutes from creation, keyed by horizon.
FLOW_POST_TERMINAL_CHECKPOINTS={}
FLOW_RECORDER_SEGMENT_SECONDS=15
FLOW_RECORDER_SEGMENT_ROWS=10000
# Complete executed-flow window; 60 enables minute-by-minute confirmation.
FLOW_EXECUTION_WINDOW_SECONDS=900
FLOW_SETTLE_COINS=["USDT"]
FLOW_CORE_WATCHLIST=["BTCUSDT","ETHUSDT"]
FLOW_DEEP_SYMBOLS=8
FLOW_MIN_DAILY_TURNOVER=20000000
FLOW_MAX_SPREAD_BPS=5
FLOW_QUOTE_SAMPLE_SECONDS=60
FLOW_SPREAD_MIN_SAMPLES=12
FLOW_HYPOTHETICAL_NOTIONAL=1000
FLOW_EQUITY=
FLOW_RISK_FRACTION=0.0025
FLOW_LEVERAGE=3
# Optional, separate research channel. Empty means dry-run only.
FLOW_RESEARCH_WEBHOOK=
FLOW_DISCORD_WEBHOOK=
FLOW_RESEARCH_ALERTS=false
# Required for the container listener. Generate a random password; user is 'research'.
FLOW_ADMIN_TOKEN=
FLOW_DASHBOARD_URL=http://127.0.0.1:8000

FLOW_SPREAD_BUCKET_SECONDS=60
FLOW_SPREAD_WINDOW_MINUTES=30
