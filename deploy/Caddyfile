{
    # Capability URLs must never enter access/error logs. Diagnose via durable ingress status.
    log default {
        level FATAL
    }
    admin off
}

{$FLOW_GATEWAY_DOMAIN} {
    @ingress {
        path /ingress/{$FLOW_TV_TOKEN}
        method POST
    }
    handle @ingress {
        rewrite * /webhooks/tradingview
        reverse_proxy desk:8000 {
            header_up X-TV-Key {$FLOW_TV_TOKEN}
        }
    }
    handle {
        respond "Not found" 404
    }
}
